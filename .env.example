# PostgreSQL connection string.
DATABASE_URL="postgresql://booking:booking@localhost:9998/booking?schema=public"

# Only relevant for providers with separate "pooled" vs "direct" connection
# strings (Neon is the common one — the pooled one has "-pooler" in the
# hostname). Prisma Migrate/db push/seed always use DIRECT_URL, never the
# pooled DATABASE_URL — schema changes can't go through a PgBouncer
# transaction pooler. If your database doesn't distinguish the two (local
# Postgres, Aiven, docker-compose), just copy the same value as DATABASE_URL.
DIRECT_URL="postgresql://booking:booking@localhost:9998/booking?schema=public"

# Secret used to sign JWT session cookies (generate a long random string)
JWT_SECRET="change-me-to-a-long-random-string"

# Admin bootstrap account created by prisma/seed.ts
ADMIN_EMAIL="admin@example.com"
ADMIN_PASSWORD="admin12345"

# Booking slot granularity, minutes
SLOT_STEP_MINUTES="15"

# Weekly cleanup job (scripts/scheduler.ts, runs as its own docker-compose
# service): time zone the "Sunday 00:00" cutoff is evaluated in, and an
# optional cron override.
TZ="Europe/Moscow"
# PURGE_CRON="0 0 * * 0"

# Only needed if you trigger the weekly cleanup via HTTP instead of the
# docker-compose `scheduler` service — see /api/internal/purge and
# deploy-guide/README.md ("бесплатно без карты" setup). Generate with
# `openssl rand -base64 32`. Leave unset to disable that endpoint entirely.
# PURGE_SECRET="change-me-to-a-long-random-string"
